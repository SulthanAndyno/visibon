# Extractor default: "ollama" (lokal, gratis) atau "gemini" (cloud)
VISIBON_EXTRACTOR=ollama

# --- Ollama (lokal, RTX 3050 4GB) ---
VISIBON_OLLAMA_BASE_URL=http://localhost:11434
# qwen3-vl:2b  -> muat penuh di VRAM 4GB, cepat (rekomendasi default)
# qwen3-vl:4b  -> lebih akurat, tapi sebagian offload ke CPU (lebih lambat)
VISIBON_OLLAMA_MODEL=qwen3-vl:2b
VISIBON_OLLAMA_TIMEOUT=180

# --- Gemini (cloud, opsional: uv sync --extra gemini) ---
GEMINI_API_KEY=
VISIBON_GEMINI_MODEL=gemini-3.8-flash

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- Preprocessing ---
# Sisi terpanjang gambar yang dikirim ke VLM. Kecil = hemat VRAM & cepat.
VISIBON_MAX_IMAGE_SIDE=1280
VISIBON_BLUR_THRESHOLD=60
